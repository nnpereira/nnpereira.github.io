---
layout: layouts/default.liquid
---
<div class="main-sections">
  
  <section>
    <h1> Hi, I'm Niha — writer, visual thinker, and data analyst.</h1>
    <h2> I share what I'm reading and learning about here.</h2>
  </section>
  <section>
    <h5>POSTS</h5>
    {% assign posts = collections.posts %}
    {% assign count = 3 %}
    {% include "postlist.liquid" %}
    {% if posts.size > 3 %}
      <a style="text-decoration: none;" href="/articles">more...</a> 
    {% endif %} 
  </section>

  {% assign tagList = collections | postTags %} {% if tagList.length > 0 %}
  <section>
    <h5>TOPICS</h5>
    {%- for tag in tagList -%}
    <a href="/tags/{{ tag.name }}">{{ tag.name }}({{ tag.count }})</a>{% if
    forloop.last != true %}<span>, </span>{% endif %} {%- endfor -%}
  </section>
  {% endif %}


{% assign tagged_posts = posts | where_exp: "post", "post.data.tags != nil" %}

</div>


<style>
  .main-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    width: 100%;
  }
  .articles-link {
    display: block;
    margin-top: var(--space-4);
  }

  blockquote {
    font-size: var(--font-size-lg); 
  }

  .underline {
    text-decoration: underline;
  }
  
</style>
